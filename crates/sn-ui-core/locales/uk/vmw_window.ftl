# The VMW mode of the WF window. SA's control names (Y scale, As time, Bright,
# WaveForm, TS, Info) and the units S, ms, us, ns are names: keep them.

vmw-strobe = Strobe
    .hover = Строб: кожен N-й період (від 1 до 1000); перетворює малі похибки періоду на нахили
vmw-y-scale = Y scale
    .hover = Висота рядка растра в пікселях
vmw-as-time = As time
    .hover = Період рядка дорівнює інтервалу між маркерами V у WF
    .disabled = Спочатку встановіть маркери V у WF
vmw-waveform = WaveForm
    .hover = Назад до WF
vmw-info = Info
    .hover = Показати dT, S і частоту рядків TSs
vmw-ts = TS
    .hover = Період рядка S:ms.us.ns. Ліве клацання на цифрі: +1, праве: -1
vmw-period-slider = TS
    .hover = Період рядка (грубо, логарифмічно)
vmw-status = dT
    .hover = Інтервал між маркерами V і його частота

