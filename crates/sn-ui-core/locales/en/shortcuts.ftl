# Keyboard shortcuts window, keyboard menu items and the accessible names of
# plots (read by screen readers). Key names (Cmd, Ctrl, Shift, Space, F1, Left,
# ...) are written by the program and stay in English.

keys-title = Keyboard shortcuts
keys-intro = Single keys act on the active window while no text field or button has the keyboard focus (press Escape to leave it).
keys-selected-signal = Selected { $signal }

keys-section-general = General
keys-section-views = Open the active window's signal in
keys-section-plot = Active view
keys-section-interface = Interface

keys-open-recording = Open a recording
keys-save-session = Save the session
keys-save-session-as = Save the session as a new file
keys-close-tab = Close the active window
keys-next-tab = Bring the next window to the front
keys-prev-tab = Bring the previous window to the front
keys-next-signal = Show the next signal of the session
keys-prev-signal = Show the previous signal of the session
keys-open-view = { $view }
keys-guide = Show or hide the workflow guide
keys-shortcuts = Show or hide this help
keys-restore-markers = Restore the markers cleared last
keys-play = Play or stop
keys-zoom-selection = Zoom to the selection
keys-zoom-back = Back to the previous zoom
keys-full-view = Show the whole signal
keys-measure-br = Measure Br (needs the H markers)
keys-measure-sc = Measure Sc (needs the H markers)
keys-nudge-v = Move the last moved V marker by 1 pixel
keys-nudge-h = Move the last moved H marker by 1 pixel (sonogram)
keys-nudge-fast = Move the marker by 10 pixels
keys-focus = Move the keyboard focus to the next or previous control
keys-activate = Press the focused button, or run the open dialog
keys-escape = Cancel the open dialog, or leave the focused control
keys-zoom-in = Enlarge the interface
keys-zoom-out = Shrink the interface
keys-zoom-reset = Reset the interface scale

keys-plot-view = { $view } of { $signal }

# $key: the key that opens the guide.
keys-open-guide = Open the workflow guide ({ $key })
