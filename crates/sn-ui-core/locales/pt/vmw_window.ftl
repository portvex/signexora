# The VMW mode of the WF window. SA's control names (Y scale, As time, Bright,
# WaveForm, TS, Info) and the units S, ms, us, ns are names: keep them.

vmw-strobe = Strobe
    .hover = Strobe: um período em cada N (1 a 1000); amplia pequenos erros de período em inclinações
vmw-y-scale = Y scale
    .hover = Altura de uma linha do raster em píxeis
vmw-as-time = As time
    .hover = O período de linha segue o intervalo entre os marcadores V do WF
    .disabled = Coloque primeiro os marcadores V no WF
vmw-waveform = WaveForm
    .hover = Voltar ao WF
vmw-info = Info
    .hover = Mostrar dT, S e a taxa de linha TSs
vmw-ts = TS
    .hover = Período de linha S:ms.us.ns. Clique esquerdo num dígito: +1, clique direito: -1
vmw-period-slider = TS
    .hover = Período de linha (grosso, logarítmico)
vmw-status = dT
    .hover = Intervalo entre os marcadores V e a sua taxa

## Popup menu (SigNexora tools).

vmw-popup-start-v1 = Começar o raster no primeiro marcador V do WF
vmw-popup-from-dt = Período de linha = último dT medido
vmw-popup-colours = Mapa de cores
vmw-popup-sa-colours = Signals Analyzer
