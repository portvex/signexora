# Sonogram view. SizeFFT and Shear are Signals Analyzer toolbar names.

sono-shear-size = Size
# $divisor: 2, 4, 8 or 16.
sono-shear-fraction = Size/{ $divisor }
sono-job-computing = Computing sonogram
sono-no-spectrum = Cannot compute the spectrum.
# $error: error text from the analysis engine (not translated).
sono-failed = Sonogram failed: { $error }. Change SizeFFT, Shear or the zoom to retry.
