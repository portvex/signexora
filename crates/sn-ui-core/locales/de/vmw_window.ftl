# The VMW mode of the WF window. SA's control names (Y scale, As time, Bright,
# WaveForm, TS, Info) and the units S, ms, us, ns are names: keep them.

vmw-strobe = Strobe
    .hover = Strobe: jede N-te Periode (1 bis 1000); macht kleine Periodenfehler als Schräge sichtbar
vmw-y-scale = Y scale
    .hover = Höhe einer Rasterzeile in Pixeln
vmw-as-time = As time
    .hover = Die Zeilenperiode folgt dem Abstand der V-Marker in WF
    .disabled = Zuerst die V-Marker in WF setzen
vmw-waveform = WaveForm
    .hover = Zurück zu WF
vmw-info = Info
    .hover = dT, S und die Zeilenrate TSs zeigen
vmw-ts = TS
    .hover = Zeilenperiode S:ms.us.ns. Linksklick auf eine Ziffer: +1, Rechtsklick: -1
vmw-period-slider = TS
    .hover = Zeilenperiode (grob, logarithmisch)
vmw-status = dT
    .hover = Abstand der V-Marker und seine Rate

## Popup menu (SigNexora tools).

vmw-popup-start-v1 = Raster am ersten V-Marker von WF beginnen
vmw-popup-from-dt = Zeilenperiode = zuletzt gemessenes dT
vmw-popup-colours = Farbskala
vmw-popup-sa-colours = Signals Analyzer
