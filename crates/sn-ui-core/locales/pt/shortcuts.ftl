# Janela de atalhos de teclado, itens de menu para o teclado e nomes
# acessíveis dos gráficos (lidos por leitores de tela). Os nomes das teclas
# (Cmd, Ctrl, Shift, Space, F1, Left...) são escritos pelo programa, em inglês.

keys-title = Atalhos de teclado
keys-intro = Teclas simples agem na janela ativa enquanto nenhum campo ou botão tiver o foco do teclado (Escape o remove).
keys-selected-signal = { $signal } selecionado

keys-section-general = Geral
keys-section-views = Abrir o sinal da janela ativa em
keys-section-plot = Vista ativa
keys-section-interface = Interface

keys-open-recording = Abrir uma gravação
keys-save-session = Salvar a sessão
keys-save-session-as = Salvar a sessão em um novo arquivo
keys-close-tab = Fechar a janela ativa
keys-next-tab = Trazer a próxima janela para a frente
keys-prev-tab = Trazer a janela anterior para a frente
