# Sonogram view. SizeFFT and Shear are Signals Analyzer toolbar names.

sono-shear-size = Size
# $divisor: 2, 4, 8 or 16.
sono-shear-fraction = Size/{ $divisor }
sono-job-computing = Berechne Sonagramm
sono-no-spectrum = Spektrum kann nicht berechnet werden.
# $error: error text from the analysis engine (not translated).
sono-failed = Sonagramm fehlgeschlagen: { $error }. SizeFFT, Shear oder Zoom ändern und erneut versuchen.
