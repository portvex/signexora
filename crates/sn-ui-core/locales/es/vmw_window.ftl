# The VMW mode of the WF window. SA's control names (Y scale, As time, Bright,
# WaveForm, TS, Info) and the units S, ms, us, ns are names: keep them.

vmw-strobe = Strobe
    .hover = Strobe: un periodo de cada N (1 a 1000); amplifica pequeños errores de periodo en pendientes
vmw-y-scale = Y scale
    .hover = Altura de una línea del ráster en píxeles
vmw-as-time = As time
    .hover = El periodo de línea sigue el intervalo entre los marcadores V de WF
    .disabled = Coloque primero los marcadores V en WF
vmw-waveform = WaveForm
    .hover = Volver a WF
vmw-info = Info
    .hover = Mostrar dT, S y la frecuencia de línea TSs
vmw-ts = TS
    .hover = Periodo de línea S:ms.us.ns. Clic izquierdo en un dígito: +1, clic derecho: -1
vmw-period-slider = TS
    .hover = Periodo de línea (grueso, logarítmico)
vmw-status = dT
    .hover = Intervalo entre los marcadores V y su frecuencia

## Popup menu (SigNexora tools).

vmw-popup-start-v1 = Empezar el ráster en el primer marcador V de WF
vmw-popup-from-dt = Periodo de línea = último dT medido
vmw-popup-colours = Mapa de colores
vmw-popup-sa-colours = Signals Analyzer
